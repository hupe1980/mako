  {
    "name": "get_kunde",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "kunden_id"
      ],
      "type": "object",
      "properties": {
        "kunden_id": {
          "type": "string"
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Lieferstelle": {
          "description": "One Lieferstelle of a customer and the state of its supply.",
          "type": "object",
          "properties": {
            "malo_id": {
              "description": "The Marktlokation.",
              "type": "string"
            },
            "sparte": {
              "description": "`STROM`, `GAS`, …",
              "type": "string"
            },
            "vertrags_nr": {
              "description": "The Versorgungsvertrag's number.",
              "type": "string"
            },
            "standort": {
              "description": "The contract's Standort, as the customer named it.",
              "type": [
                "string",
                "null"
              ]
            },
            "lieferbeginn": {
              "description": "First day of supply.",
              "type": "string",
              "format": "date"
            },
            "lieferende": {
              "description": "Last day of supply, when one is set.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "status": {
              "description": "The Vertragskomponente's state: `ANGELEGT`, `ANGEMELDET`, `BESTAETIGT`,\n`AKTIV`, `BEENDET`, `ABGELEHNT` or `STORNIERT`.",
              "type": "string"
            }
          },
          "required": [
            "malo_id",
            "sparte",
            "vertrags_nr",
            "lieferbeginn",
            "status"
          ]
        }
      },
      "required": [
        "id",
        "kundentyp",
        "haushaltskunde",
        "lieferstellen",
        "lieferstellen_gesamt"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "The Kunde's id.",
          "type": "string"
        },
        "kunden_nr": {
          "description": "The Kundennummer, if one was assigned.",
          "type": [
            "string",
            "null"
          ]
        },
        "kundentyp": {
          "description": "`B2C`, `B2B_SLP`, `B2B_RLM` or `B2B_HV`.",
          "type": "string"
        },
        "haushaltskunde": {
          "description": "§ 3 Nr. 57 EnWG Haushaltskunde — it decides the customer's Fristen.",
          "type": "boolean"
        },
        "name": {
          "description": "„Vorname Nachname\" of the BO4E `Person` or `Geschaeftspartner`, else its `name1`.",
          "type": [
            "string",
            "null"
          ]
        },
        "lieferstellen": {
          "description": "Lieferstellen — Vertragskomponenten with a MaLo — newest first, at most\n[`LIEFERSTELLEN_SEITE`].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Lieferstelle"
          }
        },
        "lieferstellen_gesamt": {
          "description": "How many Lieferstellen the customer has, however many are listed.",
          "type": "integer",
          "format": "int64"
        }
      }
    }
  },
