  {
    "name": "list_anmeldungen",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "description": "Max results (default 200, max 500).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "ohne_prozess": {
          "description": "Only those makod has not accepted yet — no process carries them.",
          "type": "boolean",
          "default": false
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Anmeldung": {
          "description": "A Lieferstelle the Lieferant has registered at the Netzbetreiber and that\nis not answered yet. Whether it is late is makod's to say — the deadline its\nworkflow registered for the MaLo — so this carries no age and no threshold.",
          "type": "object",
          "properties": {
            "kunden_id": {
              "description": "The customer's id.",
              "type": "string"
            },
            "name": {
              "description": "The customer's name, as `search_kunden` shows it.",
              "type": [
                "string",
                "null"
              ]
            },
            "kunden_nr": {
              "description": "The Kundennummer, if one was assigned.",
              "type": [
                "string",
                "null"
              ]
            },
            "malo_id": {
              "description": "The Marktlokation registered.",
              "type": "string"
            },
            "sparte": {
              "description": "`STROM`, `GAS`, …",
              "type": "string"
            },
            "vertrags_nr": {
              "description": "The Versorgungsvertrag's number.",
              "type": "string"
            },
            "mako_process_id": {
              "description": "The makod process carrying the Anmeldung, once makod accepted it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kunden_id",
            "malo_id",
            "sparte",
            "vertrags_nr"
          ]
        }
      },
      "required": [
        "anmeldungen",
        "gesamt"
      ],
      "type": "object",
      "properties": {
        "anmeldungen": {
          "description": "Lieferstellen in `ANGEMELDET`, by customer name — at most `limit`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Anmeldung"
          }
        },
        "gesamt": {
          "description": "How many Lieferstellen are in `ANGEMELDET`, however many are listed.",
          "type": "integer",
          "format": "int64"
        }
      }
    }
  },
