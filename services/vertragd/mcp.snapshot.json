          }
        },
        "next_cursor": {
          "description": "The cursor of the next page; absent on the last.",
          "type": [
            "string",
            "null"
          ]
        },
        "total_estimate": {
          "description": "How many rows the whole list holds, where the list counts them.",
          "anyOf": [
