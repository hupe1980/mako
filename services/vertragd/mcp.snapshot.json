  {
    "name": "search_kunden",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "description": "What the person typed: the start of any word of a name, or of a Kundennummer, or a whole\nMaLo-ID. At least three characters.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "KundeTreffer": {
          "description": "One customer the operator's search found.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The Kunde's id.",
              "type": "string"
            },
            "kunden_nr": {
              "description": "The Kundennummer, if one was assigned.",
              "type": [
                "string",
                "null"
              ]
            },
            "kundentyp": {
              "description": "`B2C`, `B2B_SLP`, `B2B_RLM` or `B2B_HV`.",
              "type": "string"
            },
            "name": {
              "description": "The name a person recognises: „Vorname Nachname\" of the BO4E `Person`\nor `Geschaeftspartner`, else the Geschäftspartner's `name1`.",
              "type": [
                "string",
                "null"
              ]
            },
            "lieferstellen": {
              "description": "How many Lieferstellen (Vertragskomponenten with a MaLo) the Kunde has.",
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "id",
            "kundentyp",
            "lieferstellen"
          ]
        }
      },
      "required": [
        "query",
        "treffer",
        "mehr"
      ],
      "type": "object",
      "properties": {
        "query": {
          "description": "The query, trimmed, as it was searched.",
          "type": "string"
        },
        "treffer": {
          "description": "At most twenty customers, by name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KundeTreffer"
          }
        },
        "mehr": {
          "description": "More customers match than were returned — the person should type more.",
          "type": "boolean"
        }
      }
    }
  }
