  {
    "name": "kunden_zu_malos",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "malos"
      ],
      "properties": {
        "malos": {
          "description": "One to 200 MaLo-IDs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "MaloKunde": {
          "description": "Who supplies a MaLo, as a worklist row names it.",
          "type": "object",
          "properties": {
            "malo_id": {
              "description": "The Marktlokation asked about.",
              "type": "string"
            },
            "kunden_id": {
              "description": "The customer's id.",
              "type": "string"
            },
            "name": {
              "description": "The customer's name, as `search_kunden` shows it.",
              "type": [
                "string",
                "null"
              ]
            },
            "kunden_nr": {
              "description": "The Kundennummer, if one was assigned.",
              "type": [
                "string",
                "null"
              ]
            },
            "sparte": {
              "description": "`STROM`, `GAS`, …",
              "type": "string"
            },
            "status": {
              "description": "The Vertragskomponente's status (`ANGEMELDET`, `AKTIV`, …).",
              "type": "string"
            }
          },
          "required": [
            "malo_id",
            "kunden_id",
            "sparte",
            "status"
          ]
        }
      },
      "required": [
        "kunden"
      ],
      "type": "object",
      "properties": {
        "kunden": {
          "description": "One row per MaLo with a Vertragskomponente in this tenant.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaloKunde"
          }
        }
      }
    }
