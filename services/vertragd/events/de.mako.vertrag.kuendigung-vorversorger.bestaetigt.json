{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KuendigungVorversorgerBestaetigt",
  "description": "The `data` of `de.mako.vertrag.kuendigung-vorversorger.bestaetigt`.",
  "type": "object",
  "properties": {
    "vertrag_id": {
      "type": "string",
      "format": "uuid"
    },
    "vertrags_nr": {
      "type": "string"
    },
    "kunden_id": {
      "description": "The Kunde the contract is with — the customer number of the portfolio\nroute.",
      "type": "string",
      "format": "uuid"
    },
    "erp_contract_id": {
      "description": "The caller's contract reference, where the contract was created with one.",
      "type": [
        "string",
        "null"
      ]
    },
    "bestellreferenz": {
      "description": "The front end's order reference, where the contract came from an order.",
      "type": [
        "string",
        "null"
      ]
    },
    "komp_id": {
      "type": "string",
      "format": "uuid"
    },
    "sparte": {
      "type": "string"
    },
    "malo_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lieferbeginn": {
      "description": "The day supply begins, as the contract holds it.",
      "type": "string",
      "format": "date"
    },
    "vorversorger_mp_id": {
      "description": "The previous supplier that confirmed.",
      "type": "string"
    },
    "kuendigung_zum": {
      "description": "The end of the old contract the Kündigung named.",
      "type": "string",
      "format": "date"
    },
    "antwortcode": {
      "type": [
        "string",
        "null"
      ]
    },
    "codeliste": {
      "type": [
        "string",
        "null"
      ]
    },
    "reaktion": {
      "description": "Whether the Anmeldung went out (`angemeldet`) or waits (`gehalten`).",
      "$ref": "#/$defs/Reaktion"
    }
  },
  "required": [
    "vertrag_id",
    "vertrags_nr",
    "kunden_id",
    "komp_id",
    "sparte",
    "lieferbeginn",
    "vorversorger_mp_id",
    "kuendigung_zum",
    "reaktion"
  ],
  "$defs": {
    "Reaktion": {
      "description": "Whether the Anmeldung goes out after the answer.",
      "type": "string",
      "enum": [
        "angemeldet",
        "gehalten"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/mako/schemas/events/de.mako.vertrag.kuendigung-vorversorger.bestaetigt.json"
}
