{
  "openapi": "3.1.0",
  "info": {
    "title": "edmd — Energiedatenmanagement",
    "description": "Meter data of the Marktlokationen: the version-resolved series, its quality, corrections and per-day coverage. Describes the routes edmd mounts through its documented router.",
    "contact": {
      "name": "hupe1980"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.37.0"
  },
  "paths": {
    "/api/v1/corrections/{malo_id}": {
      "get": {
        "tags": [
          "messwerte"
        ],
        "summary": "The corrections recorded for a Marktlokation (Cedar `read-corrections`).",
        "operationId": "get_corrections",
        "parameters": [
          {
            "name": "malo_id",
            "in": "path",
            "description": "11-digit Marktlokations-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Earliest `corrected_at`, RFC 3339; defaults to 90 days ago.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Latest `corrected_at`, RFC 3339; defaults to now.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "At most this many (default 100, at most 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The corrections, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Korrekturen"
                }
              }
            }
          },
          "400": {
            "description": "invalid_instant"
          }
        }
      }
    },
    "/api/v1/coverage/{malo_id}": {
      "get": {
        "tags": [
          "messwerte"
        ],
        "summary": "One state per day — gemessen, ersatzwert, korrigiert, fehlt — for a\nMarktlokation (Cedar `read-timeseries`).",
        "operationId": "get_coverage",
        "parameters": [
          {
            "name": "malo_id",
            "in": "path",
            "description": "11-digit Marktlokations-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "First day, `YYYY-MM-DD`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last day, `YYYY-MM-DD` (inclusive).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sparte",
            "in": "query",
            "description": "`STROM`, `GAS`, `WAERME` or `WASSER`; absent, the Sparte the MaLo's\nreadings are stored under.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One state per day",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Abdeckung"
                }
              }
            }
          },
          "400": {
            "description": "invalid_date, zeitraum_ungueltig"
          },
          "422": {
            "description": "zeitraum_zu_lang, sparte_unklar"
          }
        }
      }
    },
    "/api/v1/quality/{malo_id}": {
      "get": {
        "tags": [
          "messwerte"
        ],
        "summary": "The quality verdict over a window (Cedar `read-timeseries`).",
        "operationId": "get_quality",
        "parameters": [
          {
            "name": "malo_id",
            "in": "path",
            "description": "11-digit Marktlokations-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Window start, RFC 3339; defaults per route.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Window end, RFC 3339; defaults to now.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The verdict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Qualitaetsbefund"
                }
              }
            }
          },
          "400": {
            "description": "invalid_instant"
          },
          "404": {
            "description": "no_data: nothing stored in the window"
          }
        }
      }
    },
    "/api/v1/timeseries/{malo_id}": {
      "get": {
        "tags": [
          "messwerte"
        ],
        "summary": "The version-resolved series of a Marktlokation (Cedar `read-timeseries`).",
        "operationId": "get_timeseries",
        "parameters": [
          {
            "name": "malo_id",
            "in": "path",
            "description": "11-digit Marktlokations-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Window start, RFC 3339.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Window end, RFC 3339.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Messwerte"
                }
              }
            }
          },
          "400": {
            "description": "invalid_instant, zeitraum_ungueltig"
          },
          "422": {
            "description": "zeitraum_zu_lang"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Abdeckung": {
        "type": "object",
        "description": "One state per day for a Marktlokation's series.",
        "required": [
          "malo_id",
          "sparte",
          "von",
          "bis",
          "tage",
          "gemessen",
          "ersatzwert",
          "korrigiert",
          "fehlt"
        ],
        "properties": {
          "bis": {
            "type": "string",
            "format": "date",
            "description": "Last day answered: the requested `to`, or the last day that has\nalready ended when `to` lies later. Before `von` when no requested day\nhas ended yet, and then `tage` is empty."
          },
          "ersatzwert": {
            "type": "integer",
            "minimum": 0
          },
          "fehlt": {
            "type": "integer",
            "minimum": 0
          },
          "gemessen": {
            "type": "integer",
            "minimum": 0
          },
          "korrigiert": {
            "type": "integer",
            "minimum": 0
          },
          "malo_id": {
            "type": "string"
          },
          "sparte": {
            "type": "string",
            "description": "`STROM`, `GAS`, `WAERME` or `WASSER` — Gas days are Gastage\n(06:00–06:00 Berlin), every other Sparte's calendar days."
          },
          "tage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "description": "One entry per day, oldest first."
          },
          "von": {
            "type": "string",
            "format": "date",
            "description": "First day answered."
          }
        }
      },
      "Korrektur": {
        "type": "object",
        "description": "One retroactive correction of a stored interval (§ 147 Abs. 1 AO /\n§ 146 Abs. 4 AO, GoBD).",
        "required": [
          "correction_id",
          "dtm_from",
          "dtm_to",
          "original_kwh",
          "original_quality",
          "corrected_kwh",
          "corrected_quality",
          "reason",
          "source",
          "corrected_at"
        ],
        "properties": {
          "corrected_at": {
            "type": "string",
            "format": "date-time"
          },
          "corrected_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "corrected_kwh": {
            "type": "string",
            "format": "decimal"
          },
          "corrected_quality": {
            "$ref": "#/components/schemas/Messwertqualitaet"
          },
          "correction_id": {
            "type": "string",
            "format": "uuid"
          },
          "dtm_from": {
            "type": "string",
            "format": "date-time"
          },
          "dtm_to": {
            "type": "string",
            "format": "date-time"
          },
          "obis_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The register corrected; absent when the correction named none."
          },
          "original_kwh": {
            "type": "string",
            "format": "decimal"
          },
          "original_quality": {
            "$ref": "#/components/schemas/Messwertqualitaet"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "`MSCONS_UPDATE`, `OPERATOR`, `AUTO_SUBSTITUTE`, `IMSYS_DIRECT_PUSH` or\n`OTHER`."
          }
        }
      },
      "Korrekturen": {
        "type": "object",
        "description": "The corrections recorded for a Marktlokation in a window, newest first.",
        "required": [
          "malo_id",
          "from",
          "to",
          "count",
          "saturated",
          "corrections"
        ],
        "properties": {
          "corrections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Korrektur"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "description": "Window over `corrected_at`."
          },
          "malo_id": {
            "type": "string"
          },
          "saturated": {
            "type": "boolean",
            "description": "`limit` corrections matched: older ones may exist beyond the page."
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Messwert": {
        "type": "object",
        "description": "One stored interval of a Marktlokation's series.",
        "required": [
          "dtm_from",
          "dtm_to",
          "quantity_kwh",
          "quality"
        ],
        "properties": {
          "dtm_from": {
            "type": "string",
            "format": "date-time",
            "description": "Interval start."
          },
          "dtm_to": {
            "type": "string",
            "format": "date-time",
            "description": "Interval end (exclusive)."
          },
          "obis_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The register's OBIS-Kennzahl, when the delivery named one."
          },
          "quality": {
            "$ref": "#/components/schemas/Messwertqualitaet",
            "description": "The value's quality."
          },
          "quantity_kwh": {
            "type": "string",
            "format": "decimal",
            "description": "The quantity in the Sparte's billing unit (kWh; m³ for water)."
          }
        }
      },
      "Messwerte": {
        "type": "object",
        "description": "The version-resolved series of a Marktlokation over a window.",
        "required": [
          "malo_id",
          "from",
          "to",
          "count",
          "readings"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "How many intervals `readings` holds.",
            "minimum": 0
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "description": "Window start (inclusive)."
          },
          "malo_id": {
            "type": "string"
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Messwert"
            },
            "description": "Every register's intervals, oldest first. Empty when nothing was\ndelivered for the window."
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "description": "Window end."
          }
        }
      },
      "Messwertqualitaet": {
        "type": "string",
        "description": "The quality of one stored value — the MSCONS Messwertstatus: `MEASURED`\n(Messwert), `ESTIMATED` (Prognosewert), `SUBSTITUTED` (Ersatzwert),\n`CALCULATED` (Rechenwert), `CORRECTED` (Nachbearbeitungswert),\n`PRELIMINARY` (vorläufig), `FAULTY` (fehlerhaft, not billable), `UNKNOWN`.\n\nThe variants carry no doc comment of their own: one would make schemars\ndescribe the enum as a `oneOf` of constants where utoipa writes an `enum`,\nand the two doors' schemas would differ.",
        "enum": [
          "MEASURED",
          "ESTIMATED",
          "SUBSTITUTED",
          "CALCULATED",
          "CORRECTED",
          "PRELIMINARY",
          "FAULTY",
          "UNKNOWN"
        ]
      },
      "Note": {
        "type": "string",
        "description": "A quality grade: `A` clean, `B` warnings, `C` errors an Ersatzwert\nrepairs, `F` blocking — the window is not billable as it stands.",
        "enum": [
          "A",
          "B",
          "C",
          "F"
        ]
      },
      "Qualitaetsbefund": {
        "type": "object",
        "description": "The quality verdict over a window, recomputed from the version-resolved\nseries by the scorer the ingest and rescore paths run.",
        "required": [
          "malo_id",
          "window_from",
          "window_to",
          "interval_count",
          "grade",
          "has_warnings",
          "gaps_detected",
          "zero_run_length",
          "coverage_pct",
          "intervals_consistent",
          "outlier_intervals",
          "spike_intervals",
          "algorithm"
        ],
        "properties": {
          "algorithm": {
            "type": "string",
            "description": "The validation that produced the verdict."
          },
          "coverage_pct": {
            "type": "string",
            "format": "decimal",
            "description": "Delivered time inside the window over its length, in percent."
          },
          "expected_intervals": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Slots the window holds on the observed grid; absent without one.",
            "minimum": 0
          },
          "gaps_detected": {
            "type": "integer",
            "description": "Slots of the window no interval delivered.",
            "minimum": 0
          },
          "grade": {
            "$ref": "#/components/schemas/Note"
          },
          "has_warnings": {
            "type": "boolean"
          },
          "interval_count": {
            "type": "integer",
            "description": "Intervals scored.",
            "minimum": 0
          },
          "intervals_consistent": {
            "type": "boolean",
            "description": "`false`: a slot delivered twice or a span off the grid kept the\ncontent rules from running."
          },
          "malo_id": {
            "type": "string"
          },
          "outlier_intervals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Interval starts flagged as statistical outliers."
          },
          "spike_intervals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Interval starts above the plant's physical capacity."
          },
          "window_from": {
            "type": "string",
            "format": "date-time"
          },
          "window_to": {
            "type": "string",
            "format": "date-time"
          },
          "zero_run_length": {
            "type": "integer",
            "description": "The longest run of zeros, in slots.",
            "minimum": 0
          }
        }
      },
      "Tag": {
        "type": "object",
        "description": "One day of the ribbon.",
        "required": [
          "tag",
          "zustand"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "format": "date",
            "description": "The Berlin calendar day — for Gas the Gastag starting 06:00 that day."
          },
          "zustand": {
            "$ref": "#/components/schemas/Tageszustand"
          }
        }
      },
      "Tageszustand": {
        "type": "string",
        "description": "What a day of a Marktlokation's series holds: `gemessen` — every slot of\nevery energy register a measured value; `ersatzwert` — complete, with at\nleast one Ersatz- or Prognosewert; `korrigiert` — complete, no Ersatzwert,\nat least one corrected slot; `fehlt` — at least one slot of an energy\nregister without a billable value.",
        "enum": [
          "gemessen",
          "ersatzwert",
          "korrigiert",
          "fehlt"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "messwerte",
      "description": "Meter data reads"
    }
  ]
}
