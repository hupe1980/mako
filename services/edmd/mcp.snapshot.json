  {
    "name": "get_imbalance",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "malo_id",
        "year",
        "month",
        "bilanziert_kwh"
      ],
      "type": "object",
      "properties": {
        "malo_id": {
          "description": "11-digit Marktlokations-ID.",
          "type": "string"
        },
        "year": {
          "description": "Year (e.g. 2026).",
          "type": "integer",
          "format": "int32"
        },
        "month": {
          "description": "Month (1–12).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "bilanziert_kwh": {
          "description": "The bilanzierte (profile-allocated) quantity for the month, in kWh.\n\nRequired: edmd holds the measured half of the saldo only. The bilanzierte\nMenge comes from the Bilanzkreisabrechnung, not from metering data.",
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$"
        },
        "sparte": {
          "description": "`STROM` or `GAS` — Gas balances on the 06:00 Gastag. Absent, the Sparte\nthe MaLo's readings are stored under; with none stored, refused.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "outputSchema": null
  },
