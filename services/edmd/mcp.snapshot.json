              "description": "The quantity in the Sparte's billing unit (kWh; m³ for water).",
              "type": "string",
              "format": "decimal"
            },
            "quality": {
              "description": "The value's quality.",
              "$ref": "#/$defs/Messwertqualitaet"
            },
            "obis_code": {
              "description": "The register's OBIS-Kennzahl, when the delivery named one.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "dtm_from",
            "dtm_to",
            "quantity_kwh",
            "quality",
            "obis_code"
          ]
        },
        "Messwertqualitaet": {
          "description": "The quality of one stored value — the MSCONS Messwertstatus: `MEASURED`\n(Messwert), `ESTIMATED` (Prognosewert), `SUBSTITUTED` (Ersatzwert),\n`CALCULATED` (Rechenwert), `CORRECTED` (Nachbearbeitungswert),\n`PRELIMINARY` (vorläufig), `FAULTY` (fehlerhaft, not billable), `UNKNOWN`.\n\nThe variants carry no doc comment of their own: one would make schemars\ndescribe the enum as a `oneOf` of constants where utoipa writes an `enum`,\nand the two doors' schemas would differ.",
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "SUBSTITUTED",
            "CALCULATED",
            "CORRECTED",
            "PRELIMINARY",
            "FAULTY",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "malo_id",
        "from",
        "to",
        "count",
        "readings"
      ],
      "type": "object",
      "properties": {
        "malo_id": {
          "type": "string"
        },
        "from": {
          "description": "Window start (inclusive).",
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "description": "Window end.",
          "type": "string",
          "format": "date-time"
        },
        "count": {
          "description": "How many intervals `readings` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "readings": {
          "description": "Every register's intervals, oldest first. Empty when nothing was\ndelivered for the window.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Messwert"
          }
        }
      }
    }
  },
  {
    "name": "list_overdue_reading_orders",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "ausfuehrender_msb": {
          "description": "Filter by NB/MSB MP-ID (optional).",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Max results (default 100).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "UeberfaelligerAbleseauftrag": {
          "description": "One reading order past its `ausfuehrt_bis` deadline.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The reading order.",
              "type": "string"
            },
            "malo_id": {
              "description": "11-digit Marktlokations-ID.",
              "type": "string"
            },
            "anlass": {
              "description": "Why the reading is owed (`JAHRESABLESUNG`, …).",
              "type": "string"
            },
            "ausfuehrender_msb": {
              "description": "MP-ID of the MSB executing the reading, where one is assigned.",
              "type": [
                "string",
                "null"
              ]
            },
            "ausfuehrt_bis": {
              "description": "The last Berlin business day the reading was due on.",
              "type": "string",
              "format": "date"
            },
            "frist": {
              "description": "The instant the deadline lapsed — the end of the Berlin day\n`ausfuehrt_bis` — RFC 3339 in UTC.",
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "description": "`OFFEN`, `BEAUFTRAGT` or `FEHLGESCHLAGEN`.",
              "type": "string"
            },
            "fehlschlag_grund": {
              "description": "Why a FEHLGESCHLAGEN order failed.",
              "type": [
                "string",
                "null"
              ]
            },
            "days_overdue": {
              "description": "Berlin calendar days from `ausfuehrt_bis` to today.",
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "id",
            "malo_id",
            "anlass",
            "ausfuehrender_msb",
            "ausfuehrt_bis",
            "frist",
            "status",
            "fehlschlag_grund",
            "days_overdue"
          ]
        }
      },
      "required": [
        "auftraege",
        "count",
        "saturated",
        "failed_count"
      ],
      "type": "object",
      "properties": {
        "auftraege": {
          "description": "The oldest `ausfuehrt_bis` first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UeberfaelligerAbleseauftrag"
          }
        },
        "count": {
          "description": "How many orders `auftraege` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "saturated": {
          "description": "At least `limit` orders matched: more may be overdue than were listed.",
          "type": "boolean"
        },
        "failed_count": {
          "description": "How many of them are FEHLGESCHLAGEN.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      }
    }
  },
