  {
    "name": "get_quality_warnings",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "malo_id"
      ],
      "properties": {
        "malo_id": {
          "description": "11-digit Marktlokations-ID.",
          "type": "string"
        },
        "from": {
          "description": "ISO-8601 start datetime (inclusive). Defaults to 30 days ago when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "ISO-8601 end datetime (exclusive). Defaults to now when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Note": {
          "description": "A quality grade: `A` clean, `B` warnings, `C` errors an Ersatzwert\nrepairs, `F` blocking — the window is not billable as it stands.",
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "F"
          ]
        }
      },
      "required": [
        "malo_id",
        "window_from",
        "window_to",
        "interval_count",
        "grade",
        "has_warnings",
        "gaps_detected",
        "zero_run_length",
        "coverage_pct",
        "intervals_consistent",
        "expected_intervals",
        "outlier_intervals",
        "spike_intervals",
        "algorithm"
      ],
      "type": "object",
      "properties": {
        "malo_id": {
          "type": "string"
        },
        "window_from": {
          "type": "string",
          "format": "date-time"
        },
        "window_to": {
          "type": "string",
          "format": "date-time"
        },
        "interval_count": {
          "description": "Intervals scored.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "grade": {
          "$ref": "#/$defs/Note"
        },
        "has_warnings": {
          "type": "boolean"
        },
        "gaps_detected": {
          "description": "Slots of the window no interval delivered.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "zero_run_length": {
          "description": "The longest run of zeros, in slots.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "coverage_pct": {
          "description": "Delivered time inside the window over its length, in percent.",
          "type": "string",
          "format": "decimal"
        },
        "intervals_consistent": {
          "description": "`false`: a slot delivered twice or a span off the grid kept the\ncontent rules from running.",
          "type": "boolean"
        },
        "expected_intervals": {
          "description": "Slots the window holds on the observed grid; absent without one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "outlier_intervals": {
          "description": "Interval starts flagged as statistical outliers.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spike_intervals": {
          "description": "Interval starts above the plant's physical capacity.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "algorithm": {
          "description": "The validation that produced the verdict.",
          "type": "string"
        }
      }
    }
  },
