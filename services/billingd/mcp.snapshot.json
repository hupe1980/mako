  {
    "name": "recompute_invoice",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "UUID of the billing record.",
          "type": "string"
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Verdict": {
          "description": "The verdict on one invoice.",
          "type": "object",
          "properties": {
            "matches": {
              "description": "Every line and total recomputes and the seal holds — „Stimmt überein\".",
              "type": "boolean"
            },
            "arithmetic_matches": {
              "description": "Every line and total recomputes to the cent.",
              "type": "boolean"
            },
            "seal_holds": {
              "description": "The stored document still hashes to the seal taken at issue. `None`\nfor a record never issued (no seal yet).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "mismatched_positions": {
              "description": "The positions whose stated amount does not recompute.",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            },
            "storniert": {
              "description": "The invoice was cancelled by a Storno.",
              "type": "boolean"
            }
          },
          "required": [
            "matches",
            "arithmetic_matches",
            "seal_holds",
            "mismatched_positions",
            "storniert"
          ]
        },
        "LineView": {
          "description": "One recomputed line, amounts as decimal strings.",
          "type": "object",
          "properties": {
            "position": {
              "description": "`positionsnummer`, from 1.",
              "type": "integer",
              "format": "int64"
            },
            "text": {
              "description": "The line's text as printed.",
              "type": "string"
            },
            "quantity": {
              "description": "Quantity as stated.",
              "type": [
                "string",
                "null"
              ]
            },
            "unit": {
              "description": "Unit (`KWH`, `Tage`, …).",
              "type": [
                "string",
                "null"
              ]
            },
            "unit_price_eur": {
              "description": "Unit price in EUR, full precision.",
              "type": [
                "string",
                "null"
              ]
            },
            "stated_eur": {
              "description": "The line amount the invoice states.",
              "type": [
                "string",
                "null"
              ]
            },
            "recomputed_eur": {
              "description": "Quantity × unit price, to the cent.",
              "type": [
                "string",
                "null"
              ]
            },
            "difference_eur": {
              "description": "`stated − recomputed`.",
              "type": [
                "string",
                "null"
              ]
            },
            "matches": {
              "description": "The line recomputes to the cent.",
              "type": "boolean"
            },
            "formula": {
              "description": "The calculation as the engine wrote it.",
              "type": [
                "string",
                "null"
              ]
            },
            "rules": {
              "description": "Provisions the line bills under.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "price_source": {
              "description": "Where the unit price comes from.",
              "type": [
                "string",
                "null"
              ]
            },
            "quantity_source": {
              "description": "How the quantity was obtained (§ 40 Abs. 2 Nr. 6 EnWG).",
              "type": [
                "string",
                "null"
              ]
            },
            "estimated": {
              "description": "The quantity is an estimate or an Ersatzwert (§ 40a EnWG).",
              "type": "boolean"
            }
          },
          "required": [
            "position",
            "text",
            "quantity",
            "unit",
            "unit_price_eur",
            "stated_eur",
            "recomputed_eur",
            "difference_eur",
            "matches",
            "formula",
            "rules",
            "price_source",
            "quantity_source",
            "estimated"
          ]
        },
        "TotalView": {
          "description": "One recomputed document total.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "`NETTO`, `STEUER`, `STEUERBASIS`, `GESAMTSTEUER`, `BRUTTO`, `ZU_ZAHLEN`.",
              "type": "string"
            },
            "rate_percent": {
              "description": "VAT rate in percent, on a `STEUER` row.",
              "type": [
                "string",
                "null"
              ]
            },
            "stated_eur": {
              "description": "The amount the invoice states.",
              "type": [
                "string",
                "null"
              ]
            },
            "recomputed_eur": {
              "description": "The amount recomputed.",
              "type": "string"
            },
            "matches": {
              "description": "The two agree to the cent.",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "rate_percent",
            "stated_eur",
            "recomputed_eur",
            "matches"
          ]
        }
      },
      "required": [
        "record_id",
        "rechnungsnummer",
        "malo_id",
        "period_from",
        "period_to",
        "dispatched_at",
        "verdict",
        "lines",
        "totals",
        "vorauszahlungen_eur",
        "public_link"
      ],
      "type": "object",
      "properties": {
        "record_id": {
          "description": "The billing record.",
          "type": "string"
        },
        "rechnungsnummer": {
          "description": "§ 14 Abs. 4 Nr. 4 UStG Rechnungsnummer.",
          "type": "string"
        },
        "malo_id": {
          "description": "11-digit MaLo-ID.",
          "type": "string"
        },
        "period_from": {
          "description": "First day of the billed period.",
          "type": "string",
          "format": "date"
        },
        "period_to": {
          "description": "Last day of the billed period.",
          "type": "string",
          "format": "date"
        },
        "dispatched_at": {
          "description": "Issuance time from the billing record. Channel evidence is owned by outputd.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verdict": {
          "description": "The verdict, on top.",
          "$ref": "#/$defs/Verdict"
        },
        "lines": {
          "description": "Every line, in the invoice's order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineView"
          }
        },
        "totals": {
          "description": "Every document total.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TotalView"
          }
        },
        "vorauszahlungen_eur": {
          "description": "Sum of the Vorauszahlungen deducted.",
          "type": "string"
        },
        "public_link": {
          "description": "The public Nachrechnen link printed on the invoice (and in its QR\ncode), when `[nachrechnen]` is configured — what the customer opens.",
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    }
  },
