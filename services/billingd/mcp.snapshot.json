            },
            "next_attempt_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "error_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "candidate_count": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "last_failure_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
