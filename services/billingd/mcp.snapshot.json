  {
    "name": "list_review_queue",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "ReviewBand": {
          "description": "The band `list_review_queue` narrows to.",
          "oneOf": [
            {
              "description": "Dispatched; queued for analyst review.",
              "type": "string",
              "const": "REVIEW"
            },
            {
              "description": "Not dispatched until an analyst releases it.",
              "type": "string",
              "const": "HELD"
            }
          ]
        }
      },
      "properties": {
        "band": {
          "description": "`REVIEW` or `HELD`; unset lists both.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewBand"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Max results (default 50, clamped to 1–200).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Pruefposten": {
          "description": "One billing record on the analyst review queue.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The billing record — what `POST /api/v1/billing/{id}/release` (HELD) and\n`POST /api/v1/billing/{id}/reviewed` (REVIEW) address.",
              "type": "string"
            },
            "malo_id": {
              "description": "11-digit MaLo-ID.",
              "type": "string"
            },
            "lf_mp_id": {
              "description": "MP-ID of the Lieferant that issued the invoice.",
              "type": "string"
            },
            "rechnungsnummer": {
              "description": "§ 14 Abs. 4 Nr. 4 UStG Rechnungsnummer.",
              "type": "string"
            },
            "category": {
              "description": "Billing category (`STROM`, `GAS`, …).",
              "type": "string"
            },
            "period_from": {
              "description": "First day of the billed period.",
              "type": "string",
              "format": "date"
            },
            "period_to": {
              "description": "End of the billed period.",
              "type": "string",
              "format": "date"
            },
            "total_brutto_eur": {
              "description": "Gross total in EUR, a decimal string.",
              "type": "string"
            },
            "risk_band": {
              "description": "`REVIEW` (dispatched, queued for review) or `HELD` (not dispatched).",
              "type": "string"
            },
            "risk_score": {
              "description": "Deterministic risk score 0–100.",
              "type": [
                "integer",
                "null"
              ],
              "format": "int16",
              "minimum": -32768,
              "maximum": 32767
            },
            "risk_findings": {
              "description": "The coded findings the score is the sum of.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/RiskFinding"
              }
            },
            "created_at": {
              "description": "RFC 3339 in UTC.",
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "malo_id",
            "lf_mp_id",
            "rechnungsnummer",
            "category",
            "period_from",
            "period_to",
            "total_brutto_eur",
            "risk_band",
            "risk_score",
            "risk_findings",
            "created_at"
          ]
        },
        "RiskFinding": {
          "description": "One scored observation about an invoice. The full set is persisted as\n`billing_records.risk_findings` — the audit-proof explanation of the score.",
          "type": "object",
          "properties": {
            "code": {
              "description": "Stable machine-readable code (e.g. `TAX_BREAKDOWN_MISMATCH`).",
              "type": "string"
            },
            "weight": {
              "description": "Points this finding contributes to the score.",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            },
            "message": {
              "description": "Human-readable reason with the concrete values that triggered it.",
              "type": "string"
            },
            "blocking": {
              "description": "This finding holds the invoice on its own, whatever the score says.\n\nMost findings are *evidence* — they say an invoice looks unusual, and\nthe score decides how much attention that earns. A few are *verdicts*:\na period straddling a statutory rate boundary has no correct single\nrate, so part of what was billed is wrong no matter what else is true.\nExpressing a verdict as a large weight leaves it at the mercy of\n`hold_at`, which an operator may raise.",
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "code",
            "weight",
            "message",
            "blocking"
          ]
        }
      },
      "required": [
        "records",
        "count",
        "saturated"
      ],
      "type": "object",
      "properties": {
        "records": {
          "description": "The highest risk score first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pruefposten"
          }
        },
        "count": {
          "description": "How many records `records` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "saturated": {
          "description": "At least `limit` records matched: more may be waiting than were listed.",
          "type": "boolean"
        }
      }
    }
  },
  {
    "name": "list_unbilled_periods",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "include_settled": {
          "description": "Include the periods an invoice has since discharged (default `false`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "limit": {
          "description": "Max results (default 100, clamped to 1–500).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "UnbilledPeriodRow": {
          "description": "One recorded unbilled period, as the Desk's Heute and the MCP tool read it.",
          "type": "object",
          "properties": {
            "malo_id": {
              "type": "string"
            },
            "lf_mp_id": {
              "type": "string"
            },
            "period_from": {
              "type": "string",
              "format": "date"
            },
            "period_to": {
              "type": "string",
              "format": "date"
            },
            "final_invoice": {
              "description": "The period ends with the supply and is owed an Abschlussrechnung.",
              "type": "boolean"
            },
            "reason_code": {
              "description": "Stable refusal code — word it from the catalogue, never show it raw.",
              "type": "string"
            },
            "due_on": {
              "description": "§ 40c Abs. 2 EnWG: the last day the invoice may reach the customer.",
              "type": "string",
              "format": "date"
            },
            "days_left": {
              "description": "Days from today (Europe/Berlin) to `due_on`; negative once overdue.",
              "type": "integer",
              "format": "int32"
            },
            "attempts": {
              "type": "integer",
              "format": "int32"
            },
            "settled_by": {
              "description": "The invoice that discharged the period; `None` while it is open.",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "malo_id",
            "lf_mp_id",
            "period_from",
            "period_to",
            "final_invoice",
            "reason_code",
            "due_on",
            "days_left",
            "attempts",
            "settled_by"
          ]
        },
        "Discovery": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "business_date": {
              "type": "string",
              "format": "date"
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "next_attempt_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "error_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "candidate_count": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "last_failure_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "ended_from": {
              "type": "string",
              "format": "date"
            },
            "ended_through": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "run_id",
            "business_date",
            "started_at",
            "finished_at",
            "next_attempt_at",
            "source",
            "origin",
            "status",
            "error_code",
            "candidate_count",
            "last_failure_at",
            "ended_from",
            "ended_through"
          ]
        }
      },
      "required": [
        "periods",
        "count",
        "saturated",
        "discovery"
      ],
      "type": "object",
      "properties": {
        "periods": {
          "description": "The earliest `due_on` first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnbilledPeriodRow"
          }
        },
        "count": {
          "description": "How many periods `periods` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "saturated": {
          "description": "At least `limit` periods matched: more may be waiting than were listed.",
          "type": "boolean"
        },
        "discovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Discovery"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
