{
  "openapi": "3.1.0",
  "info": {
    "title": "einsd — EEG/KWKG feed-in settlement",
    "description": "The documented reads of `einsd`: plants, Förderende, MaStR status and settlement receipts. Each is also an MCP tool answering the same type.",
    "contact": {
      "name": "hupe1980"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.37.0"
  },
  "paths": {
    "/api/v1/anlagen/foerderung-auslaufend": {
      "get": {
        "tags": [
          "anlagen"
        ],
        "operationId": "list_expiring",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Look-ahead window in days (default 180).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active plants whose Förderung ends within the horizon",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuslaufendeAnlagen"
                }
              }
            }
          },
          "400": {
            "description": "A negative horizon"
          },
          "403": {
            "description": "Cedar `read-anlage` refused"
          }
        }
      }
    },
    "/api/v1/anlagen/ohne-mastr": {
      "get": {
        "tags": [
          "anlagen"
        ],
        "operationId": "list_plants_without_mastr",
        "responses": {
          "200": {
            "description": "Active plants not registered in the MaStR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnlagenOhneMastr"
                }
              }
            }
          },
          "403": {
            "description": "Cedar `read-anlage` refused"
          }
        }
      }
    },
    "/api/v1/anlagen/unabgerechnet/{year}/{month}": {
      "get": {
        "tags": [
          "settlements"
        ],
        "operationId": "list_unsettled_plants",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "description": "Abrechnungsjahr",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "path",
            "description": "Abrechnungsmonat, 1–12",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active plants with no receipt for the month",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnabgerechneteAnlagen"
                }
              }
            }
          },
          "400": {
            "description": "A month outside 1–12"
          },
          "403": {
            "description": "Cedar `read-settlement` refused"
          }
        }
      }
    },
    "/api/v1/anlagen/{tr_id}": {
      "get": {
        "tags": [
          "anlagen"
        ],
        "operationId": "get_plant",
        "parameters": [
          {
            "name": "tr_id",
            "in": "path",
            "description": "TechnischeRessource ID of the plant",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The plant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnlageRow"
                }
              }
            }
          },
          "403": {
            "description": "Cedar `read-anlage` refused"
          },
          "404": {
            "description": "`anlage_not_found`"
          }
        }
      }
    },
    "/api/v1/anlagen/{tr_id}/settlements": {
      "get": {
        "tags": [
          "settlements"
        ],
        "operationId": "list_settlements",
        "parameters": [
          {
            "name": "tr_id",
            "in": "path",
            "description": "TechnischeRessource ID of the plant",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "description": "Abrechnungsjahr, e.g. `2026`.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Abrechnungsmonat, 1–12. A month without a year narrows every year to\nthat month, which is what a year-on-year comparison asks for.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "At most this many receipts (default 24, at most 200).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The plant's receipts, the newest month first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Abrechnungen"
                }
              }
            }
          },
          "400": {
            "description": "A month outside 1–12, or an unknown parameter"
          },
          "403": {
            "description": "Cedar `read-settlement` refused"
          }
        }
      }
    },
    "/api/v1/anlagen/{tr_id}/settlements/{year}/{month}/erklaerung": {
      "get": {
        "tags": [
          "settlements"
        ],
        "operationId": "explain_settlement",
        "parameters": [
          {
            "name": "tr_id",
            "in": "path",
            "description": "TechnischeRessource ID of the plant",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "description": "Abrechnungsjahr",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "path",
            "description": "Abrechnungsmonat, 1–12",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The newest receipt for the month with its positions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbrechnungsErklaerung"
                }
              }
            }
          },
          "400": {
            "description": "A month outside 1–12"
          },
          "403": {
            "description": "Cedar `read-settlement` refused"
          },
          "404": {
            "description": "`settlement_not_found`"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Abrechnungen": {
        "type": "object",
        "description": "`list_settlements`' answer: a plant's receipts, the newest month first.",
        "required": [
          "tr_id",
          "count",
          "saturated",
          "settlements"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "saturated": {
            "type": "boolean",
            "description": "At least `limit` receipts matched: older ones were not listed."
          },
          "settlements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettlementReceipt"
            }
          },
          "tr_id": {
            "type": "string"
          }
        }
      },
      "AbrechnungsErklaerung": {
        "type": "object",
        "description": "`explain_settlement`'s answer: the newest receipt for the month and its\npositions as stored.",
        "required": [
          "tr_id",
          "billing_year",
          "billing_month",
          "settlement_model",
          "status",
          "verlaengerungsanspruch_qh",
          "settled_at",
          "positions",
          "interpretation"
        ],
        "properties": {
          "billing_days_fraction": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal"
          },
          "billing_month": {
            "type": "integer",
            "format": "int32"
          },
          "billing_year": {
            "type": "integer",
            "format": "int32"
          },
          "einspeisemenge_kwh": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal"
          },
          "interpretation": {
            "type": "string"
          },
          "pflichtzahlung_eur": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "description": "A separate § 52 EEG 2023 Pflichtzahlung owed to the Netzbetreiber."
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Abrechnungsposition"
            }
          },
          "settled_at": {
            "type": "string",
            "format": "date-time"
          },
          "settlement_eur": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "description": "The sum of the positions' `eur`."
          },
          "settlement_model": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "The receipt's status code (see `list_settlements`)."
          },
          "tr_id": {
            "type": "string"
          },
          "verlaengerungsanspruch_qh": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Abrechnungsposition": {
        "type": "object",
        "description": "One position of a stored settlement receipt.",
        "required": [
          "description",
          "legal_basis",
          "kwh",
          "rate_ct_kwh",
          "eur"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "eur": {
            "type": "string",
            "format": "decimal"
          },
          "kwh": {
            "type": "string",
            "format": "decimal"
          },
          "legal_basis": {
            "type": "string",
            "description": "The provision the position rests on."
          },
          "rate_ct_kwh": {
            "type": "string",
            "format": "decimal"
          }
        }
      },
      "AnlageOhneMastr": {
        "type": "object",
        "description": "One active plant not registered in the MaStR.",
        "required": [
          "tr_id",
          "malo_id",
          "erzeugungsart",
          "leistung_kwp",
          "eeg_gesetz",
          "regime"
        ],
        "properties": {
          "eeg_gesetz": {
            "type": "integer",
            "format": "int32"
          },
          "erzeugungsart": {
            "type": "string"
          },
          "leistung_kwp": {
            "type": "string",
            "format": "decimal"
          },
          "malo_id": {
            "type": "string"
          },
          "monthly_penalty_eur": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "description": "§ 52 Abs. 2 EEG 2023: 10 €/kW per month; `None` for a plant under the\npre-2023 regime, which owes no Pflichtzahlung."
          },
          "regime": {
            "type": "string",
            "description": "The rule the plant falls under, as text."
          },
          "tr_id": {
            "type": "string"
          }
        }
      },
