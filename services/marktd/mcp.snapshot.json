          "type": "string"
        }
      }
    },
    "outputSchema": null
  },
  {
    "name": "get_versorgung_at",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "malo_id",
        "at"
      ],
      "type": "object",
      "properties": {
        "malo_id": {
          "description": "11-digit MaLo ID.",
          "type": "string"
        },
        "at": {
          "description": "Reference date (YYYY-MM-DD).  Returns the supply status valid on that date.",
          "type": "string"
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Lieferstatus": {
          "description": "The Lieferstatus of a Marktlokation.",
          "type": "string",
          "enum": [
            "Beliefert",
            "Unbeliefert",
            "Grundversorgung",
            "Ersatzversorgung",
            "Ruhend",
            "Stillgelegt"
          ]
        },
        "Zuordnung": {
          "description": "One Lieferant's share of a Marktlokation.",
          "type": "object",
          "properties": {
            "lf_mp_id": {
              "description": "MP-ID of the Lieferant holding this share.",
              "type": "string"
            },
            "prozent": {
              "description": "The share in percent — `100` for an untranchierte Marktlokation.",
              "type": "string",
              "format": "decimal"
            },
            "tranche_id": {
              "description": "Tranchen-ID of a tranchierte Marktlokation.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/Zuordnungsstatus"
            },
            "zuordnungsbeginn": {
              "description": "Zuordnungsbeginn — the Lieferbeginn of this assignment.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "zuordnungsende": {
              "description": "Zuordnungsende, once one is agreed.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "process_id": {
              "description": "The process that wrote this assignment.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "lf_mp_id",
            "prozent",
            "tranche_id",
            "status",
            "zuordnungsbeginn",
            "zuordnungsende",
            "process_id"
          ]
        },
        "Zuordnungsstatus": {
          "description": "Whether a Zuordnung is announced (Anmeldung in flight) or running.",
          "type": "string",
          "enum": [
            "Angekuendigt",
            "Aktiv"
          ]
        }
      },
      "required": [
        "malo_id",
        "lieferstatus",
        "zuordnungen",
        "lf_mp_id",
        "lf_mp_id_next",
        "lf_next_lieferbeginn",
        "lieferbeginn",
        "lieferende",
        "msb_mp_id",
        "nb_mp_id",
        "eog_seit",
        "last_process_id",
        "updated_at",
        "version"
      ],
      "type": "object",
      "properties": {
        "malo_id": {
          "type": "string"
        },
        "lieferstatus": {
          "$ref": "#/$defs/Lieferstatus"
        },
        "zuordnungen": {
          "description": "Every Lieferant holding a share of this Marktlokation — the authoritative\nanswer to „who supplies it\". A tranchierte Marktlokation carries several.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zuordnung"
          }
        },
        "lf_mp_id": {
          "description": "The single active Lieferant, when there is exactly one.\n\nDerived from `zuordnungen` and **absent on a tranchierte\nMarktlokation**, where no single supplier exists — read `zuordnungen`\nthere rather than treating the omission as „unsupplied\".",
          "type": [
            "string",
            "null"
          ]
        },
        "lf_mp_id_next": {
          "description": "The single announced Lieferant, when exactly one Anmeldung is pending.\nDerived, with the same caveat as `lf_mp_id`.",
          "type": [
            "string",
            "null"
          ]
        },
        "lf_next_lieferbeginn": {
          "description": "Lieferbeginn of the announced Lieferant.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "lieferbeginn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "lieferende": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "msb_mp_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "nb_mp_id": {
          "type": "string"
        },
        "eog_seit": {
          "description": "Start of the running Ersatz-/Grundversorgung (§38/§36 EnWG), if any.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "last_process_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "description": "When this state was written (RFC 3339) — for a state read `at` a date,\nwhen that historic state became active.",
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "description": "Optimistic-locking version, also the `ETag`.",
          "type": "integer",
          "format": "int64"
        }
      }
    }
  },
  {
    "name": "get_versorgungsstatus",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "malo_id"
