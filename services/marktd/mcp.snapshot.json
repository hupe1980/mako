[
  {
    "name": "get_correlation",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "process_id": {
          "description": "UUID of the `makod` workflow process (from `de.mako.process.initiated` CloudEvents `process_id` extension).",
          "type": [
            "string",
            "null"
          ]
        },
        "erp_order_id": {
          "description": "ERP-side order reference (from `erp_order_id` CloudEvents extension).\nMatches the reference set by the ERP when submitting a command.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": null
  },
  {
    "name": "get_lokationsbuendel",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "malo_id",
        "stichtag"
      ],
      "properties": {
        "malo_id": {
          "description": "11-digit MaLo ID.",
          "type": "string"
        },
        "stichtag": {
          "description": "The date the bündel is resolved for (YYYY-MM-DD). Required: a bündel\nchanges over time, and „today\" is a choice the caller makes.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Objekt": {
          "description": "One object of the bündel.",
          "type": "object",
          "properties": {
            "typ": {
              "$ref": "#/$defs/Objekttyp"
            },
            "id": {
              "type": "string"
            },
            "objektcode": {
              "description": "BO4E `lokationsbuendelObjektcode` — the object's position in the\nLokationsbündelstruktur.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "typ",
            "id",
            "objektcode"
          ]
        },
        "Objekttyp": {
          "description": "The kind of object in a Lokationsbündel.",
          "type": "string",
          "enum": [
            "MALO",
            "MELO",
            "NELO",
            "SR",
            "TR"
          ]
        },
        "Kante": {
          "description": "One edge of the bündel valid on the Stichtag, half-open\n`[valid_from, valid_to)`.",
          "type": "object",
          "properties": {
            "von_id": {
              "type": "string"
            },
            "von_typ": {
              "$ref": "#/$defs/Objekttyp"
            },
            "nach_id": {
              "type": "string"
            },
            "nach_typ": {
              "$ref": "#/$defs/Objekttyp"
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "valid_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "required": [
            "von_id",
            "von_typ",
            "nach_id",
            "nach_typ",
            "valid_from",
            "valid_to"
          ]
        },
        "Angaben": {
          "description": "The NB's Angaben of the bündel no BO4E object carries — one dated row.",
          "type": "object",
          "properties": {
            "valid_from": {
              "type": "string",
              "format": "date"
            },
            "valid_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "uenb_mp_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "technische_einrichtungen": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "standardlastprofil": {
              "type": [
                "string",
                "null"
              ]
            },
            "profilverfahren": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Verfahren"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nna_positionen": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Nna"
              }
            },
            "obis": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Obis"
              }
            },
            "register": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Register"
              }
            }
          },
          "required": [
            "valid_from",
            "valid_to",
            "uenb_mp_id",
            "technische_einrichtungen",
            "standardlastprofil",
            "profilverfahren",
            "nna_positionen",
            "obis",
            "register"
          ]
        },
        "Verfahren": {
          "description": "The Verfahren of a normiertes Profil.",
          "type": "string",
          "enum": [
            "SYNTHETISCH",
            "ANALYTISCH"
          ]
        },
        "Nna": {
          "description": "One Netznutzungsabrechnungsposition.",
          "type": "object",
          "properties": {
            "artikel_id": {
              "type": "string"
            },
            "zu_abschlag_prozent": {
              "description": "Zuschlag (> 0) or Abschlag (< 0) in Prozent.",
              "type": "string",
              "format": "decimal"
            }
          },
          "required": [
            "artikel_id",
            "zu_abschlag_prozent"
          ]
        },
        "Obis": {
          "description": "One OBIS-Kennzahl of the Marktlokation with its Verwendungszwecke.",
          "type": "object",
          "properties": {
            "obis_kennzahl": {
              "type": "string"
            },
            "verwendungszweck_nb": {
              "type": [
                "string",
                "null"
              ]
            },
            "verwendungszweck_lf": {
              "type": [
                "string",
                "null"
              ]
            },
            "verwendungszweck_uenb": {
              "type": [
                "string",
                "null"
              ]
            },
            "wertegranularitaet": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Granularitaet"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "obis_kennzahl",
            "verwendungszweck_nb",
            "verwendungszweck_lf",
            "verwendungszweck_uenb",
            "wertegranularitaet"
          ]
        },
        "Granularitaet": {
          "description": "The Wertegranularität of a register.",
          "type": "string",
          "enum": [
            "JAEHRLICH",
            "HALBJAEHRLICH",
            "QUARTALSWEISE",
            "MONATLICH"
          ]
        },
        "Register": {
          "description": "The Wertegranularität of one register of a Zähler.",
          "type": "object",
          "properties": {
            "zaehler_id": {
              "type": "string"
            },
            "obis_kennzahl": {
              "type": "string"
            },
            "wertegranularitaet": {
              "$ref": "#/$defs/Granularitaet"
            }
          },
          "required": [
            "zaehler_id",
            "obis_kennzahl",
            "wertegranularitaet"
          ]
        },
        "Zaehler": {
          "description": "A Zähler of one of the bündel's Messlokationen.",
          "type": "object",
          "properties": {
            "melo_id": {
              "type": "string"
            },
            "zaehler_id": {
              "type": "string"
            },
            "zaehlertyp_spezifikation": {
              "description": "BO4E `Zaehler.zaehlertypSpezifikation` (`EDL40`, `EDL21`,\n`SONSTIGER_EHZ`, `MME_STANDARD`, `MME_MEDA`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "melo_id",
            "zaehler_id",
            "zaehlertyp_spezifikation"
          ]
        }
      },
      "required": [
        "malo_id",
        "stichtag",
        "energierichtung",
        "lokationsbuendelcodes",
        "objekte",
        "zuordnungen",
        "angaben",
        "zaehler"
      ],
      "type": "object",
      "properties": {
        "malo_id": {
          "type": "string"
        },
        "stichtag": {
          "description": "The date every edge and the Angaben row are resolved for.",
          "type": "string",
          "format": "date"
        },
        "energierichtung": {
          "description": "BO4E `Marktlokation.energierichtung` — `AUSSP` verbrauchend, `EINSP`\nerzeugend.",
          "type": [
            "string",
            "null"
          ]
        },
        "lokationsbuendelcodes": {
          "description": "Every distinct `lokationsbuendelcode` the bündel's edges carry; more\nthan one is a graph that disagrees with itself.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objekte": {
          "description": "Every object reached, the Marktlokation itself first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Objekt"
          }
        },
        "zuordnungen": {
          "description": "Every edge valid on the Stichtag that reached them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Kante"
          }
        },
        "angaben": {
          "description": "The NB's Angaben row covering the Stichtag.",
          "anyOf": [
            {
              "$ref": "#/$defs/Angaben"
            },
            {
              "type": "null"
            }
          ]
        },
        "zaehler": {
          "description": "The Zähler of the bündel's Messlokationen.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zaehler"
          }
        }
      }
    }
  },
