      ],
      "properties": {
        "reihe": {
          "description": "The series key, e.g. `kav_grenzpreis_strom` (see `list_referenzreihen`).",
          "type": "string"
        },
        "jahr": {
          "description": "The calendar year.",
          "type": "integer",
          "format": "int32"
        },
        "monat": {
          "description": "The month (1–12), for a monthly series.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "dim": {
          "description": "The dimension value (`spot`, `wind_an_land`, `wind_auf_see`, `solar` for\nthe EEG Marktwerte); omitted for a series without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "stand": {
          "description": "RFC 3339 instant the read is as of — what was known then. Defaults to now.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": null
  },
