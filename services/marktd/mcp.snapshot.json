              "type": [
                "string",
                "null"
              ]
            },
            "nb_mp_id": {
              "type": "string"
            },
            "last_process_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": "integer",
              "format": "int64"
            },
            "valid_from": {
              "description": "The instant this state became active (RFC 3339).",
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "malo_id",
            "lieferstatus",
            "zuordnungen",
            "lieferende",
            "msb_mp_id",
            "nb_mp_id",
            "last_process_id",
            "version",
            "valid_from"
          ]
        },
        "Lieferstatus": {
          "description": "The Lieferstatus of a Marktlokation.",
          "type": "string",
          "enum": [
            "Beliefert",
            "Unbeliefert",
            "Grundversorgung",
            "Ersatzversorgung",
            "Ruhend",
            "Stillgelegt"
          ]
        },
        "Zuordnung": {
          "description": "One Lieferant's share of a Marktlokation.",
          "type": "object",
          "properties": {
            "lf_mp_id": {
              "description": "MP-ID of the Lieferant holding this share.",
              "type": "string"
            },
            "prozent": {
              "description": "The share in percent — `100` for an untranchierte Marktlokation.",
              "type": "string",
              "format": "decimal"
            },
            "tranche_id": {
              "description": "Tranchen-ID of a tranchierte Marktlokation.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/Zuordnungsstatus"
            },
            "zuordnungsbeginn": {
              "description": "Zuordnungsbeginn — the Lieferbeginn of this assignment.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "zuordnungsende": {
              "description": "Zuordnungsende, once one is agreed.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "process_id": {
              "description": "The process that wrote this assignment.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "lf_mp_id",
            "prozent",
            "tranche_id",
            "status",
            "zuordnungsbeginn",
            "zuordnungsende",
            "process_id"
          ]
        },
        "Zuordnungsstatus": {
          "description": "Whether a Zuordnung is announced (Anmeldung in flight) or running.",
          "type": "string",
          "enum": [
            "Angekuendigt",
            "Aktiv"
          ]
        }
      },
      "required": [
        "items",
        "total",
        "page",
        "size"
      ],
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersorgungsStatusHistoryResponse"
          }
        },
        "total": {
          "description": "Every change recorded for the Marktlokation, not only this page's.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "page": {
          "description": "Zero-based page index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "size": {
          "description": "Page size (at most 500).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  },
