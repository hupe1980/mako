  {
    "name": "list_corrections",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "malo_id": {
          "description": "11-digit MaLo-ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "sender_mp_id": {
          "description": "Issuing party MP-ID — the MSB for PID 31009, the NB otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "recipient_mp_id": {
          "description": "Billed party MP-ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "description": "BDEW Prüfidentifikator: 31001, 31002, 31005, 31009 or 31011.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "sparte": {
          "description": "`Strom` or `Gas`. PID 31002 (NN-Rechnung) and 31005 (Mehr-/Mindermengen)\nare shared between the Sparten, so the Prüfidentifikator alone cannot\nseparate a gas invoice from an electricity one.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "`draft` · `dispatched` · `paid` · `disputed` · `rejected`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rechnungsart": {
          "description": "`RECHNUNG` · `STORNORECHNUNG` · `KORREKTURRECHNUNG`.",
          "type": [
            "string",
            "null"
          ]
        },
        "check_outcome": {
          "description": "`invoic-checker` verdict: `Ok` · `Warn` · `Dispute`.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum rows (default 50, capped at 500).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "type": "object"
    },
    "outputSchema": null
  },
