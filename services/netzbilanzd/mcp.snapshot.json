  {
    "name": "list_korrekturbedarf",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Korrekturbedarf": {
          "description": "One open Korrekturbedarf: a negative Prüfmitteilung no corrected\nSummenzeitreihe has answered yet.",
          "type": "object",
          "properties": {
            "pruefmitteilung_id": {
              "description": "The negative Prüfmitteilung.",
              "type": "string"
            },
            "bilanzierungsgebiet_id": {
              "description": "The Bilanzierungsgebiet (EIC) the Summenzeitreihe covers.",
              "type": "string"
            },
            "period_from": {
              "description": "First day of the period the Prüfmitteilung concerns.",
              "type": "string",
              "format": "date"
            },
            "period_to": {
              "description": "End of that period, as the Prüfmitteilung names it.",
              "type": "string",
              "format": "date"
            },
            "version": {
              "description": "The version of the Summenzeitreihe the Prüfmitteilung refuses, RFC 3339\nin UTC; the correction is filed under a higher one.",
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "pruefmitteilung_id",
            "bilanzierungsgebiet_id",
            "period_from",
            "period_to",
            "version"
          ]
        }
      },
      "required": [
        "korrekturbedarf",
        "count"
      ],
      "type": "object",
      "properties": {
        "korrekturbedarf": {
          "description": "The earliest received first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Korrekturbedarf"
          }
        },
        "count": {
          "description": "How many entries `korrekturbedarf` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      }
    }
  },
