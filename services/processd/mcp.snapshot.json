[
  {
    "name": "approve_queue_entry",
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "UUID of the approval queue entry to approve or reject.",
          "type": "string"
        },
        "decided_by": {
          "description": "Who decided, as **verified by the MCP middleware** — never the caller.\n\n`mcp_auth_middleware` overwrites whatever arrives here with the identity\nbehind the presented token, so a caller cannot name someone else. It is\n`Option` because the middleware leaves it unset when nothing identifies\na caller (dev mode, no Cedar), and an unattributable decision is refused\nrather than recorded against a placeholder: this value becomes § 20\nAbs. 1 EnWG parity evidence and a GoBD record.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "antwort_code": {
          "description": "The EBD Antwortcode, when the entry does not carry a frozen answer —\nan escalated entry, or any refusal.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "antwort_tree": {
          "description": "The Entscheidungsbaum the code is resolved in (e.g. `E_0622`).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "antwort_codeliste": {
          "description": "The Codeliste DE 1131, where the MIG carries one.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "bemerkung": {
          "description": "`FTX+ACB` Erläuterung; also the Begründung of a refusal with no code.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "outputSchema": null
  },
