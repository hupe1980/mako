  {
    "name": "list_open_processes",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "pids": {
          "description": "Prüfidentifikatoren to keep (any when empty).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "default": []
        },
        "malos": {
          "description": "MaLo-IDs to keep, at most 200 (any when empty). `pids` or `malos`\nnames at least one.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "nach": {
          "description": "The `weiter` of the previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Rows per page, 1–200 (default 50).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "ProcessRow": {
          "description": "One open process with its Frist.",
          "type": "object",
          "properties": {
            "process_id": {
              "type": "string"
            },
            "pid": {
              "description": "BDEW Prüfidentifikator.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "family": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "malo_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "partner_mp_id": {
              "description": "The counterparty's MP-ID.",
              "type": [
                "string",
                "null"
              ]
            },
            "started_at": {
              "description": "RFC 3339 in UTC.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "deadline_at": {
              "description": "When the Antwortfrist ended, RFC 3339 in UTC.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "deadline_source": {
              "description": "The Festlegung the deadline came from.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "process_id",
            "pid",
            "family",
            "state",
            "malo_id",
            "partner_mp_id",
            "started_at",
            "deadline_at",
            "deadline_source"
          ]
        }
      },
      "required": [
        "prozesse",
        "weiter"
      ],
      "type": "object",
      "properties": {
        "prozesse": {
          "description": "The earliest Frist first; those without one last.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessRow"
          }
        },
        "weiter": {
          "description": "Pass as `nach` for the next page; absent on the last.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
