  {
    "name": "get_queue_entry",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "FreigabeArt": {
          "description": "Whether the answer is already decided.",
          "oneOf": [
            {
              "description": "The module decided the answer and froze it; approving dispatches exactly\n[`Freigabe::antwort`], and a code stated beside it is refused.",
              "type": "string",
              "const": "gehalten"
            },
            {
              "description": "No answer was decided: the person states it, from\n[`Freigabe::codes_freigeben`] or [`Freigabe::codes_ablehnen`].",
              "type": "string",
              "const": "eskaliert"
            }
          ]
        },
        "Antwort": {
          "description": "The decided answer a held entry is approved with.",
          "type": "object",
          "properties": {
            "code": {
              "description": "DE 9013 — the frozen Antwortcode.",
              "type": "string"
            },
            "ebd": {
              "description": "The tree the code was resolved in, when one is known.",
              "type": [
                "string",
                "null"
              ]
            },
            "bedeutung": {
              "description": "The BDEW's wording for `code` in `ebd`; `None` when the tree does not\npublish it — never a guess from another tree.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "ebd",
            "bedeutung"
          ]
        },
        "CodeAuswahl": {
          "description": "The codes an answer of one cluster may carry, and the tree they come from.",
          "type": "object",
          "properties": {
            "ebd": {
              "description": "The Entscheidungsbaum (`E_0623`, …); state it as `antwort_tree`.",
              "type": "string"
            },
            "codes": {
              "description": "Every code of that tree in the cluster, in the catalogue's order.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/CodeBedeutung"
              }
            }
          },
          "required": [
            "ebd",
            "codes"
          ]
        },
        "CodeBedeutung": {
          "description": "One code with the BDEW's own wording for it in its tree.",
          "type": "object",
          "properties": {
            "code": {
              "description": "DE 9013 — the Antwortcode.",
              "type": "string"
            },
            "bedeutung": {
              "description": "The wording the Entscheidungsbaum prints beside it.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "bedeutung"
          ]
        },
        "QueueStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Approved",
            "Rejected",
            "Expired"
          ]
        }
      },
      "required": [
        "id",
        "process_id",
        "pid",
        "malo_id",
        "marktrolle",
        "grund",
        "art",
        "antwort",
        "codes_freigeben",
        "codes_ablehnen",
        "kann_freigeben",
        "kann_ablehnen",
        "status",
        "expires_at",
        "created_at",
        "decided_by",
        "decided_at"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "The queue entry — what approve / reject address.",
          "type": "string"
        },
        "process_id": {
          "description": "The market process the decision answers.",
          "type": "string"
        },
        "pid": {
          "description": "BDEW Prüfidentifikator of the inbound message.",
          "type": "integer",
          "format": "int32"
        },
        "malo_id": {
          "description": "The Marktlokation (the location for an ESA order), where there is one.",
          "type": [
            "string",
            "null"
          ]
        },
        "marktrolle": {
          "description": "The Marktrolle the answer is dispatched under (`NB`, `LF`, `MSB`).",
          "type": [
            "string",
            "null"
          ]
        },
        "grund": {
          "description": "Why the entry needs a person, with the Antwortfrist it runs against.",
          "type": "string"
        },
        "art": {
          "description": "Held answer or escalation.",
          "$ref": "#/$defs/FreigabeArt"
        },
        "antwort": {
          "description": "The frozen answer of a held entry.",
          "anyOf": [
            {
              "$ref": "#/$defs/Antwort"
            },
            {
              "type": "null"
            }
          ]
        },
        "codes_freigeben": {
          "description": "The codes approving is stated with — an escalation's Zustimmungen.\n`None` when approving needs no code: a held entry goes as frozen.",
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAuswahl"
            },
            {
              "type": "null"
            }
          ]
        },
        "codes_ablehnen": {
          "description": "The codes rejecting is stated with: the Ablehnungen, or — overriding a\nheld Ablehnung — the Zustimmungen, because rejecting a held answer\nsends the other cluster. `None` when the refusal carries no code.",
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAuswahl"
            },
            {
              "type": "null"
            }
          ]
        },
        "kann_freigeben": {
          "description": "Approving sends a market message.",
          "type": "boolean"
        },
        "kann_ablehnen": {
          "description": "Rejecting sends a market message.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/QueueStatus"
        },
        "expires_at": {
          "description": "The business Antwortfrist less an hour of headroom, RFC 3339 in UTC.",
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "description": "RFC 3339 in UTC.",
          "type": "string",
          "format": "date-time"
        },
        "decided_by": {
          "description": "`sub` of the principal who decided.",
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "description": "RFC 3339 in UTC.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
