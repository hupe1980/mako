  {
    "name": "suggest_payment_match",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "amount_ct",
        "reference"
      ],
      "properties": {
        "amount_ct": {
          "description": "Payment amount in 1/100 EUR cents (e.g. 12500 = 125.00 EUR).",
          "type": "integer",
          "format": "int64"
        },
        "reference": {
          "description": "Payment reference / Verwendungszweck from the bank statement.",
          "type": "string"
        },
        "iban": {
          "description": "Counterparty IBAN, when the bank reported one — the strongest evidence\nof who paid, and the rung that resolves without any guessing.",
          "type": [
            "string",
            "null"
          ]
        },
        "end_to_end_id": {
          "description": "`EndToEndId`, when the bank echoed one back.",
          "type": [
            "string",
            "null"
          ]
        },
        "value_date": {
          "description": "Value date of the payment (YYYY-MM-DD).",
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance_pct": {
          "description": "Fuzzy tolerance for the fallback rung: how many percent the open balance\nmay deviate from the payment (default 2 %). Ignored when the reference\nidentifies the account outright.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "type": "object"
    },
    "outputSchema": null
