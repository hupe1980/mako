        "reference_id": {
          "description": "External reference for audit trail (invoice number, CAMT ref, etc.).",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Human-readable description for the Kontoauszug.",
          "type": [
            "string",
            "null"
          ]
        }
      }
