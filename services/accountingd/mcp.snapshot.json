  {
    "name": "list_parked_bookings",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Max results (default 50, clamped to 1–200).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "GeparkteBuchung": {
          "description": "A parked booking, as the Desk shows it.",
          "type": "object",
          "properties": {
            "key": {
              "description": "The draft's key — what rebook and discard name.",
              "type": "string"
            },
            "art": {
              "description": "The Buchungsart.",
              "type": "string"
            },
            "malo_id": {
              "description": "The Marktlokation.",
              "type": "string"
            },
            "lf_mp_id": {
              "description": "The Lieferant's MP-ID.",
              "type": "string"
            },
            "betrag_ct": {
              "description": "Signed amount in minor units (positive: the customer owes).",
              "type": "integer",
              "format": "int64"
            },
            "buchungsdatum": {
              "description": "The booking date the ledger refused.",
              "type": "string",
              "format": "date"
            },
            "beleg": {
              "description": "The Beleg, when the draft cites one.",
              "type": [
                "string",
                "null"
              ]
            },
            "code": {
              "description": "doubleentry's rejection code; `None` for a refusal accountingd made.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535
            },
            "meldung": {
              "description": "The refusal in words.",
              "type": "string"
            },
            "hinweis": {
              "description": "What the operator can do about it, in words.",
              "type": "string"
            },
            "vorschlag_datum": {
              "description": "The first date a rebooking is accepted on, when the refusal is a\nsealed period (`301`) — the day after the last seal.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "seit": {
              "description": "When the draft was staged (RFC 3339).",
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "key",
            "art",
            "malo_id",
            "lf_mp_id",
            "betrag_ct",
            "buchungsdatum",
            "beleg",
            "code",
            "meldung",
            "hinweis",
            "vorschlag_datum",
            "seit"
          ]
        }
      },
      "required": [
        "buchungen",
        "count",
        "saturated"
      ],
      "type": "object",
      "properties": {
        "buchungen": {
          "description": "Up to `limit` parked bookings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeparkteBuchung"
          }
        },
        "count": {
          "description": "How many are parked in all.",
          "type": "integer",
          "format": "int64"
        },
        "saturated": {
          "description": "Whether `count` exceeds what `buchungen` carries.",
          "type": "boolean"
        }
      }
    }
  },
