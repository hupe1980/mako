  {
    "name": "suggest_payment_match",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "amount_ct",
        "reference"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "amount_ct": {
          "description": "Payment amount in 1/100 EUR cents (e.g. 12500 = 125.00 EUR).",
          "type": "integer",
          "format": "int64"
        },
        "reference": {
          "description": "Payment reference / Verwendungszweck from the bank statement.",
          "type": "string"
        },
        "iban": {
          "description": "Counterparty IBAN, when the bank reported one — the strongest evidence\nof who paid, and the rung that resolves without any guessing.",
          "type": [
            "string",
            "null"
          ]
        },
        "end_to_end_id": {
          "description": "`EndToEndId`, when the bank echoed one back.",
          "type": [
            "string",
            "null"
          ]
        },
        "value_date": {
          "description": "Value date of the payment (YYYY-MM-DD).",
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance_pct": {
          "description": "Fuzzy tolerance for the fallback rung: how many percent the open balance\nmay deviate from the payment (default 2 %). Ignored when the reference\nidentifies the account outright.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Zuordnungskandidat": {
          "description": "One account a payment may belong to.",
          "type": "object",
          "properties": {
            "account_id": {
              "description": "The customer account.",
              "type": "string"
            },
            "malo_id": {
              "description": "11-digit Marktlokations-ID.",
              "type": "string"
            },
            "lf_mp_id": {
              "description": "The Lieferant's MP-ID the account is kept under.",
              "type": "string"
            },
            "open_balance_ct": {
              "description": "The account's open balance in cents.",
              "type": "integer",
              "format": "int64"
            },
            "open_balance_eur": {
              "description": "`open_balance_ct` as a decimal EUR string.",
              "type": "string",
              "format": "decimal"
            },
            "matched_by": {
              "description": "The evidence: an exact rung (`iban`, `end_to_end_id`,\n`remittance_token`) or `amount_proximity`.",
              "type": "string"
            },
            "confidence": {
              "description": "`EXACT` for an exact rung; `MEDIUM` or `LOW` for amount proximity.",
              "type": "string"
            },
            "similarity_score": {
              "description": "Amount closeness 0–100, only on the amount-proximity rung.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "residual_ct": {
              "description": "What stays open after booking the payment, in cents (0 settles it).",
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "account_id",
            "malo_id",
            "lf_mp_id",
            "open_balance_ct",
            "open_balance_eur",
            "matched_by",
            "confidence",
            "similarity_score",
            "residual_ct"
          ]
        }
      },
      "required": [
        "payment_amount_ct",
        "payment_amount_eur",
        "payment_reference",
        "tolerance_pct",
        "candidates_count",
        "candidates",
        "note"
      ],
      "type": "object",
      "properties": {
        "payment_amount_ct": {
          "description": "The payment in cents.",
          "type": "integer",
          "format": "int64"
        },
        "payment_amount_eur": {
          "description": "`payment_amount_ct` as a decimal EUR string.",
          "type": "string",
          "format": "decimal"
        },
        "payment_reference": {
          "description": "The Verwendungszweck the bank reported.",
          "type": "string"
        },
        "tolerance_pct": {
          "description": "The tolerance the amount-proximity rung ran with, in percent; absent\nwhen the reference identified the account.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "candidates_count": {
          "description": "How many candidates `candidates` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "candidates": {
          "description": "One exact candidate, or up to ten ranked by amount proximity.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zuordnungskandidat"
          }
        },
        "note": {
          "description": "How to read the answer.",
          "type": "string"
        }
      }
    }
  },
