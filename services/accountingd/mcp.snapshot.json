  {
    "name": "list_dunning",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "description": "Maximum cases (default 100, at most 1000), newest Mahnung first.",
