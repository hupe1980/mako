            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Mahnfall": {
          "description": "One open dunning case.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The dunning case.",
              "type": "string"
            },
            "account_id": {
              "description": "The customer account it was opened on.",
              "type": "string"
            },
            "stufe": {
              "description": "The Mahnstufe, 1–3.",
              "type": "integer",
              "format": "int16",
              "minimum": -32768,
              "maximum": 32767
            },
            "amount_due_ct": {
              "description": "The amount the Mahnung demands, in cents.",
              "type": "integer",
              "format": "int64"
            },
            "amount_due_eur": {
              "description": "`amount_due_ct` as a decimal EUR string.",
              "type": "string",
              "format": "decimal"
            },
            "issued_at": {
              "description": "When the Mahnung was issued.",
              "type": "string",
              "format": "date-time"
            },
            "due_date": {
              "description": "The payment date the Mahnung sets.",
              "type": "string",
              "format": "date"
            },
            "sperrauftrag_ce_id": {
              "description": "The CloudEvent id of the Sperrauftrag a Mahnstufe 3 raised, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "account_id",
            "stufe",
            "amount_due_ct",
            "amount_due_eur",
            "issued_at",
            "due_date",
            "sperrauftrag_ce_id"
          ]
        }
      },
      "required": [
        "faelle",
        "count",
        "saturated"
      ],
      "type": "object",
      "properties": {
        "faelle": {
          "description": "The open cases, newest Mahnung first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mahnfall"
          }
        },
        "count": {
          "description": "How many cases `faelle` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "saturated": {
          "description": "The page is full: more cases may be open than were listed.",
          "type": "boolean"
        }
      }
    }
  },
