  {
    "name": "list_disputes",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Disput": {
          "description": "One disputed INVOIC receipt.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The receipt.",
              "type": "string"
            },
            "process_id": {
              "description": "The market process the INVOIC arrived in.",
              "type": "string"
            },
            "pid": {
              "description": "BDEW Prüfidentifikator of the INVOIC.",
              "type": "integer",
              "format": "int16",
              "minimum": -32768,
              "maximum": 32767
            },
            "sender_mp_id": {
              "description": "MP-ID of the Rechnungssteller.",
              "type": "string"
            },
            "received_at": {
              "description": "RFC 3339 in UTC.",
              "type": "string",
              "format": "date-time"
            },
            "bo4e_version": {
              "description": "BO4E schema version of the stored Rechnung.",
              "type": "string"
            },
            "frist": {
              "description": "The end of the Berlin day of the Zahlungsziel (SG8 DTM+265), RFC 3339\nin UTC; `None` when the INVOIC carries no Zahlungsziel.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "process_id",
            "pid",
            "sender_mp_id",
            "received_at",
            "bo4e_version"
          ]
        }
      },
      "required": [
        "disputes",
        "count",
        "saturated"
      ],
      "type": "object",
      "properties": {
        "disputes": {
          "description": "The most recent first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Disput"
          }
        },
        "count": {
          "description": "How many receipts `disputes` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "saturated": {
          "description": "At least 200 receipts matched: more may be disputed than were listed.",
          "type": "boolean"
        }
      }
    }
  },
