  {
    "name": "list_disputes",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Disput": {
          "description": "One disputed INVOIC receipt.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The receipt.",
              "type": "string"
            },
            "process_id": {
              "description": "The market process the INVOIC arrived in.",
              "type": "string"
            },
            "pid": {
              "description": "BDEW Prüfidentifikator of the INVOIC.",
              "type": "integer",
              "format": "int16",
              "minimum": -32768,
              "maximum": 32767
            },
            "sender_mp_id": {
              "description": "MP-ID of the Rechnungssteller.",
              "type": "string"
            },
            "rechnungsnummer": {
              "description": "The Rechnungsnummer the Rechnungssteller gave the invoice, where the\nINVOIC carried one.",
              "type": [
                "string",
                "null"
              ]
            },
            "received_at": {
              "description": "RFC 3339 in UTC.",
              "type": "string",
              "format": "date-time"
            },
            "bo4e_version": {
              "description": "BO4E schema version of the stored Rechnung.",
              "type": "string"
            },
            "frist": {
              "description": "The end of the Berlin day of the Zahlungsziel (SG8 DTM+265), RFC 3339\nin UTC; `None` when the INVOIC carries no Zahlungsziel.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "abgesendet": {
              "description": "The refusal (REMADV) went out to the Rechnungssteller. When it did not,\n`POST /api/v1/receipts/{id}/dispatch-answer` sends it — a market\nmessage; when it did, what is left is closing the dispute\n(`POST /api/v1/receipts/{id}/resolve-dispute`), which sends nothing.",
              "type": "boolean"
            },
            "befunde": {
              "description": "The invoic-checker findings that disputed the invoice, in its words.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/DisputBefund"
              }
            }
          },
          "required": [
            "id",
            "process_id",
            "pid",
            "sender_mp_id",
            "rechnungsnummer",
            "received_at",
            "bo4e_version",
            "frist",
            "abgesendet",
            "befunde"
          ]
        },
        "DisputBefund": {
          "description": "One finding a dispute rests on.",
          "type": "object",
          "properties": {
            "art": {
              "description": "The finding's kind, as `get_check_result` names it (`TariffDeviation`, …)\n— an identifier, not for a reader.",
              "type": "string"
            },
            "bezeichnung": {
              "description": "What the kind is called in German (`Preis weicht vom Preisblatt ab`).",
              "type": "string"
            },
            "text": {
              "description": "The checker's sentence.",
              "type": "string"
            }
          },
          "required": [
            "art",
            "bezeichnung",
            "text"
          ]
        }
      },
      "required": [
        "disputes",
        "count",
        "saturated"
      ],
      "type": "object",
      "properties": {
        "disputes": {
          "description": "The most recent first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Disput"
          }
        },
        "count": {
          "description": "How many receipts `disputes` holds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "saturated": {
          "description": "At least 200 receipts matched: more may be disputed than were listed.",
          "type": "boolean"
        }
      }
    }
  },
