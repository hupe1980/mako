  {
    "name": "get_process",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "business_key"
      ],
      "properties": {
        "business_key": {
          "description": "Business key: malo_id (GPKE/GeLi Gas), melo_id (WiM Strom), or vorgang_id (WiM Gas Stornierung)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "ProcessView": {
          "description": "One process under a business key, with the deadlines pending on it.",
          "type": "object",
          "properties": {
            "stream_id": {
              "description": "The process's event stream.",
              "type": "string"
            },
            "workflow_name": {
              "description": "The workflow running the process.",
              "type": "string"
            },
            "process_id": {
              "description": "The process identifier within its workflow.",
              "type": "string"
            },
            "deadlines": {
              "description": "The deadlines registered on the process's stream.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/DeadlineView"
              }
            }
          },
          "required": [
            "stream_id",
            "workflow_name",
            "process_id",
            "deadlines"
          ]
        },
        "DeadlineView": {
          "description": "One deadline pending on a process.",
          "type": "object",
          "properties": {
            "deadline_id": {
              "description": "The deadline's identifier.",
              "type": "string"
            },
            "label": {
              "description": "The label its workflow declares in `DEADLINE_LABELS`.",
              "type": "string"
            },
            "art": {
              "description": "`aperak` or `contrl` for a delivery window — the labels\n`mako_fristen` owns — and `prozess` for every deadline the workflow\nitself registered.",
              "type": "string"
            },
            "due_at": {
              "description": "When the deadline fires, RFC 3339 in UTC.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "deadline_id",
            "label",
            "art",
            "due_at"
          ]
        }
      },
      "required": [
        "business_key",
        "processes"
      ],
      "type": "object",
      "properties": {
        "business_key": {
          "description": "The business key the caller passed.",
          "type": "string"
        },
        "processes": {
          "description": "The processes indexed under the key — concurrent ones (a Lieferbeginn\nbeside a Sperrung) and finished ones alike: the correlation index is\nappend-only, so whether a process is still running is its own state,\nnot the index's.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessView"
          }
        }
      }
    }
  },
  {
    "name": "get_process_history",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "process_id"
      ],
      "properties": {
        "process_id": {
          "description": "The process id, as `get_process` returns it.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "HistoryEntry": {
          "description": "One recorded event. `richtung`, `pid` and `message_ref` are present when the\nevent is a market message, as its workflow states it — never derived from\n`event_type`, which is an identifier.",
          "type": "object",
          "properties": {
            "sequence": {
              "description": "1-based position in the process's stream.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "recorded_at": {
              "description": "When the event was recorded, RFC 3339 in UTC.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "event_type": {
              "description": "The workflow's name for the event.",
              "type": "string"
            },
            "richtung": {
              "description": "`eingang` or `ausgang` for a market message.",
              "type": [
                "string",
                "null"
              ]
            },
            "pid": {
              "description": "The message's Prüfidentifikator.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "message_ref": {
              "description": "The message's document number (`BGM` C106).",
              "type": [
                "string",
                "null"
              ]
            },
            "antwortcode": {
              "description": "DE 9013 — the code the answer gives (`A02`, `E15`, `Z12`, …).",
              "type": [
                "string",
                "null"
              ]
            },
            "codeliste": {
              "description": "DE 1131 — the Codeliste or Entscheidungsbaum that defines the code\n(`E_0622`, `S_0090`).",
              "type": [
                "string",
                "null"
              ]
            },
            "bedeutung": {
              "description": "The BDEW's wording for the code in that list, from the catalogue.\n`None` when the list does not publish the code — never another tree's\nmeaning.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "sequence",
            "recorded_at",
            "event_type",
            "richtung",
            "pid",
            "message_ref",
            "antwortcode",
            "codeliste",
            "bedeutung"
          ]
        }
      },
      "required": [
        "process_id",
        "workflow_name",
        "eintraege"
      ],
      "type": "object",
      "properties": {
        "process_id": {
          "type": "string"
        },
        "workflow_name": {
          "description": "The workflow running the process.",
          "type": "string"
        },
        "eintraege": {
          "description": "Every event of the process, in the order it was recorded.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          }
        }
      }
    }
  },
