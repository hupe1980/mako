[
  {
    "name": "einrichtung_checkliste",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "DienstZeile": {
          "description": "One daemon's line in the checklist.",
          "type": "object",
          "properties": {
            "dienst": {
              "description": "The daemon.",
              "type": "string"
            },
            "url": {
              "description": "Where it was asked.",
              "type": "string"
            },
            "status": {
              "description": "Its state.",
              "$ref": "#/$defs/DienstStatus"
            },
            "version": {
              "description": "Its version, when it answered.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "dienst",
            "url",
            "status"
          ]
        },
        "DienstStatus": {
          "description": "The state of one daemon in the checklist.",
          "oneOf": [
            {
              "description": "Answered, nothing blocks.",
              "type": "string",
              "const": "bereit"
            },
            {
              "description": "Answered with a blocking finding.",
              "type": "string",
              "const": "blockiert"
            },
            {
              "description": "Could not be asked — neither ready nor failing.",
              "type": "string",
              "const": "unerreichbar"
            },
            {
              "description": "Answered with something that is not a report.",
              "type": "string",
              "const": "unlesbar"
            }
          ]
        },
        "Punkt": {
          "description": "One readiness question of the deployment.",
          "type": "object",
          "properties": {
            "bereich": {
              "description": "The area.",
              "$ref": "#/$defs/Bereich"
            },
            "frage": {
              "description": "The question.",
              "type": "string"
            },
            "ampel": {
              "description": "Its colour.",
              "$ref": "#/$defs/Ampel"
            },
            "befunde": {
              "description": "The findings that colour it.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/DienstBefund"
              }
            }
          },
          "required": [
            "bereich",
            "frage",
            "ampel",
            "befunde"
          ]
        },
        "Bereich": {
          "description": "Which readiness question of the deployment-wide checklist a finding\nbelongs to.",
          "oneOf": [
            {
              "description": "MP-IDs per Rolle and Sparte and the agency code each implies.",
              "type": "string",
              "const": "identitaeten"
            },
            {
              "description": "AS4 and API-Webdienste certificates, key material and their expiry.",
              "type": "string",
              "const": "zertifikate"
            },
            {
              "description": "Bilanzkreise per Sparte.",
              "type": "string",
              "const": "bilanzierung"
            },
            {
              "description": "Authentication, Cedar policies, the posture of every door.",
              "type": "string",
              "const": "zugriff"
            },
            {
              "description": "The services and endpoints a daemon depends on.",
              "type": "string",
              "const": "erreichbarkeit"
            },
            {
              "description": "Profiles and adapters per format version in force.",
              "type": "string",
              "const": "formatabdeckung"
            },
            {
              "description": "Everything else a configuration states.",
              "type": "string",
              "const": "konfiguration"
            }
          ]
        },
        "Ampel": {
          "description": "The colour of a checklist item.",
          "oneOf": [
            {
              "description": "Nothing found.",
              "type": "string",
              "const": "gruen"
            },
            {
              "description": "Warnings only.",
              "type": "string",
              "const": "gelb"
            },
            {
              "description": "At least one blocking finding.",
              "type": "string",
              "const": "rot"
            },
            {
              "description": "A daemon that would answer it could not be asked.",
              "type": "string",
              "const": "unbekannt"
            }
          ]
        },
        "DienstBefund": {
          "description": "A finding with the daemon that reported it.",
          "type": "object",
          "properties": {
            "dienst": {
              "description": "The reporting daemon; `deployment` for a finding across daemons.",
              "type": "string"
            },
            "schwere": {
              "description": "Whether it refuses the boot.",
              "$ref": "#/$defs/Schwere"
            },
            "bereich": {
              "description": "The checklist area it belongs to.",
              "$ref": "#/$defs/Bereich",
              "default": "konfiguration"
            },
            "text": {
              "description": "What is wrong, in the daemon's own words.",
              "type": "string"
            },
            "pfad": {
              "description": "The setting's path in the configuration file, dotted as the loader\nnames it (`lf.bilanzkreise[1].sparte`, `party[0].mp_id`); empty for a\nfinding about the file as a whole.",
              "type": "string"
            },
            "referenz": {
              "description": "The setting's operator-policy reference entry\n(`@/docs/services/<svc>.md#policy-<key>`), for a [`PolicyChoice`].",
              "type": [
                "string",
                "null"
              ]
            },
            "quelle": {
              "description": "The document and chapter the rule rests on, where a document fixes it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "dienst",
            "schwere",
            "bereich",
            "text",
            "pfad"
          ]
        },
        "Schwere": {
          "description": "Whether a finding refuses the boot.",
          "oneOf": [
            {
              "description": "The daemon refuses to start on it.",
              "type": "string",
              "const": "blockiert"
            },
            {
              "description": "The daemon starts and warns at every boot.",
              "type": "string",
              "const": "warnung"
            }
          ]
        },
        "DienstBericht": {
          "description": "One daemon of the deployment and what it answered.",
          "type": "object",
          "properties": {
            "dienst": {
              "description": "The daemon's name as configured.",
              "type": "string"
            },
            "url": {
              "description": "Where it was asked; empty for a local `--check-config`.",
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "dienst",
            "url"
          ],
          "oneOf": [
            {
              "description": "The daemon answered with its report.",
              "type": "object",
              "properties": {
                "zustand": {
                  "type": "string",
                  "const": "erreicht"
                },
                "einrichtung": {
                  "description": "The report.",
                  "$ref": "#/$defs/Einrichtung"
                }
              },
              "required": [
                "zustand",
                "einrichtung"
              ]
            },
            {
              "description": "The daemon could not be reached or refused the request.",
              "type": "object",
              "properties": {
                "zustand": {
                  "type": "string",
                  "const": "unerreichbar"
                },
                "grund": {
                  "description": "Why.",
                  "type": "string"
                }
              },
              "required": [
                "zustand",
                "grund"
              ]
            },
            {
              "description": "The daemon answered with something that is not a report — shown\nverbatim, never dropped.",
              "type": "object",
              "properties": {
                "zustand": {
                  "type": "string",
                  "const": "unlesbar"
                },
                "grund": {
                  "description": "Why it did not parse.",
                  "type": "string"
                },
                "roh": {
                  "description": "The body as received.",
                  "type": "string"
                }
              },
              "required": [
                "zustand",
                "grund",
                "roh"
              ]
            }
          ]
        },
        "Einrichtung": {
          "description": "What one daemon reports about its configuration.",
          "type": "object",
          "properties": {
            "dienst": {
              "description": "The daemon's name.",
              "type": "string"
            },
            "version": {
              "description": "The version it is built at.",
              "type": "string"
            },
            "bereit": {
              "description": "No finding blocks.",
              "type": "boolean"
            },
            "befunde": {
              "description": "Every finding, blocking ones first.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Befund"
              }
            },
            "policy": {
              "description": "The operator policy and posture it runs under.",
              "$ref": "#/$defs/PolicyReport"
            },
            "parteien": {
              "description": "The identities it acts as; empty for a daemon that holds none.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Partei"
              },
              "default": []
            }
          },
          "required": [
            "dienst",
            "version",
            "bereit",
            "befunde",
            "policy",
            "parteien"
          ]
        },
        "Befund": {
          "description": "One finding about a daemon's configuration.",
          "type": "object",
          "properties": {
            "schwere": {
              "description": "Whether it refuses the boot.",
              "$ref": "#/$defs/Schwere"
            },
            "bereich": {
              "description": "The checklist area it belongs to.",
              "$ref": "#/$defs/Bereich",
              "default": "konfiguration"
            },
            "text": {
              "description": "What is wrong, in the daemon's own words.",
              "type": "string"
            },
            "pfad": {
              "description": "The setting's path in the configuration file, dotted as the loader\nnames it (`lf.bilanzkreise[1].sparte`, `party[0].mp_id`); empty for a\nfinding about the file as a whole.",
              "type": "string"
            },
            "referenz": {
              "description": "The setting's operator-policy reference entry\n(`@/docs/services/<svc>.md#policy-<key>`), for a [`PolicyChoice`].",
              "type": [
                "string",
                "null"
              ]
            },
            "quelle": {
              "description": "The document and chapter the rule rests on, where a document fixes it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "schwere",
            "bereich",
            "text",
            "pfad"
          ]
        },
        "PolicyReport": {
          "description": "The policy and posture a daemon runs under.",
          "type": "object",
          "properties": {
            "entries": {
              "description": "One entry per setting, in the order the daemon reports them.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/PolicyEntry"
              }
            }
          },
          "required": [
            "entries"
          ]
        },
        "PolicyEntry": {
          "description": "One line of a [`PolicyReport`].",
          "type": "object",
          "properties": {
            "key": {
              "description": "The key, e.g. `beihilfe_politik` or `allow_insecure_no_auth`.",
              "type": "string"
            },
            "value": {
              "description": "The value as written in the config (`present`/`absent` for a secret).",
              "type": "string"
            },
            "origin": {
              "description": "Set or defaulted.",
              "$ref": "#/$defs/Origin"
            },
            "class": {
              "description": "Policy or posture.",
              "$ref": "#/$defs/PolicyClass"
            },
            "quelle": {
              "description": "The primary source of the value; `None` for a posture.",
              "type": [
                "string",
                "null"
              ]
            },
            "doc": {
              "description": "The docs anchor; `None` for a posture.",
              "type": [
                "string",
                "null"
              ]
            },
            "insecure": {
              "description": "A posture in its insecure state.",
              "type": "boolean"
            },
            "review_by": {
              "description": "The review date of a setting that represents law not yet enacted.",
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "review_grund": {
              "description": "What the review checks.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "key",
            "value",
            "origin",
            "class",
            "quelle",
            "doc",
            "insecure",
            "review_by",
            "review_grund"
          ]
        },
        "Origin": {
          "description": "Whether the operator set a value or the tightening default applied.",
          "oneOf": [
            {
              "description": "The tightening default — the operator set nothing.",
              "type": "string",
              "const": "default"
            },
            {
              "description": "Set in the config file or the environment.",
              "type": "string",
              "const": "explicit"
            }
          ]
        },
        "PolicyClass": {
          "description": "What an entry describes.",
          "oneOf": [
            {
              "description": "An operator reading under `[policy]`.",
              "type": "string",
              "const": "policy"
            },
            {
              "description": "A deployment posture: an `allow_*` flag or whether a secret is present.\nNever legitimised as policy; reported so an insecure one is seen.",
              "type": "string",
              "const": "posture"
            }
          ]
        },
        "Partei": {
          "description": "An identity a daemon acts as: an MP-ID in a Marktrolle, for a Sparte where\nthe daemon knows it.",
          "type": "object",
          "properties": {
            "rolle": {
              "description": "The Marktrolle (`LF`, `NB`, `MSB`, …).",
              "type": "string"
            },
            "sparte": {
              "description": "`strom` / `gas`, where the daemon knows it.",
              "type": [
                "string",
                "null"
              ]
            },
            "mp_id": {
              "description": "The 13-digit BDEW-/DVGW-Codenummer or GLN, or a 16-character EIC.",
              "type": "string"
            }
          },
          "required": [
            "rolle",
            "mp_id"
          ]
        }
      },
      "required": [
        "bereit",
        "dienste",
        "punkte",
        "berichte"
      ],
      "type": "object",
      "properties": {
        "bereit": {
          "description": "Every item green or amber and every daemon answered.",
          "type": "boolean"
        },
        "dienste": {
          "description": "One line per daemon.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DienstZeile"
          }
        },
        "punkte": {
          "description": "One item per [`Bereich`], in [`Bereich::ALLE`] order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Punkt"
          }
        },
        "berichte": {
          "description": "Every answer as received, so nothing a daemon said is lost.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DienstBericht"
          }
        }
      }
    }
  },
