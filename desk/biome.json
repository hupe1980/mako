{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!src/data/gen",
      "!src/data/api/schema.ts",
      "!src/data/api/stand.ts",
      "!openapi.json",
      "!aria"
    ]
  },
  "formatter": {
    "includes": ["**", "!fixtures/shadow-review.json"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "plugins": ["./lint/zahlen.grit", "./lint/html.grit"]
}
