# ── .dockerignore ─────────────────────────────────────────────────────────────
# Exclude files that must not be sent to the Docker build context.
# Keeps build context small and prevents leaking sensitive local files.

# Compiled artefacts — do not send gigabytes of build cache to the daemon.
target/
fuzz/target/

# Developer tooling
.git/
.gitignore
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Local environment / secrets — never ship these.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
# Allow docs/pdfs — excluded separately because PDFs can be large.
docs/pdfs/

# Test fixtures and corpus — not needed in production image.
fuzz/corpus/
fuzz/artifacts/

# CI / GitHub Actions config — not needed in image.
.github/

# Markdown / docs — reduce context size.
*.md
docs/

# Log files.
*.log

# Lock files for package managers other than Cargo.
package-lock.json
yarn.lock
Pipfile.lock

# makotest Python sources. The crate is a workspace member, so `makotest/Cargo.toml`
# and `makotest/src/` must stay in the context or Cargo cannot resolve the
# workspace — but no service image builds it (the Docker stages are
# package-scoped: `-p makod -p marktd -p processd`), so the Python package,
# tests and build artefacts are dead weight here.
makotest/python/
makotest/tests/
makotest/README.md
**/__pycache__/
**/*.pyc
