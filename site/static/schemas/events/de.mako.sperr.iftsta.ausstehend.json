      "type": "integer",
      "format": "int32"
    },
    "max_attempts": {
      "type": "integer",
      "format": "int32"
    },
    "last_error": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "malo_id",
    "lf_mp_id",
    "attempts",
    "max_attempts",
    "last_error",
    "impact"
  ],
  "$id": "https://hupe1980.github.io/mako/schemas/events/de.mako.sperr.iftsta.ausstehend.json"
}
