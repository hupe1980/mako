{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IftstaAusstehend",
  "description": "The `data` of `de.mako.sperr.iftsta.ausstehend`.",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "external_ref": {
      "description": "The executing system's own reference, where the order carries one.",
      "type": [
        "string",
        "null"
      ]
    },
    "malo_id": {
      "type": "string"
    },
    "lf_mp_id": {
      "type": "string"
    },
    "attempts": {
